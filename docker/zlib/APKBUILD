# Maintainer: Website build <noreply@example.invalid>
pkgname=zlib
# Upstream 1.4 fixes CVE-2026-4738 in infback9 and the earlier gz_vacate
# overflow (CVE-2026-85091).
pkgver=1.4
pkgrel=0
pkgdesc="Compression and decompression library"
url="https://zlib.net/"
arch="x86_64"
license="Zlib"
makedepends="build-base"
options="!dbg"

source="https://zlib.net/zlib-$pkgver.tar.gz"
builddir="$srcdir/zlib-$pkgver"

build() {
	# Match Alpine's zlib build flags: optimize for speed and use its hardening.
	export CFLAGS="$CFLAGS -O2"
	CHOST="$CHOST" ./configure \
		--prefix=/usr \
		--shared \
		--disable-crcvx
	make
}

check() {
	make check
}

package() {
	make install DESTDIR="$pkgdir"
	# Keep only the runtime shared library and its soname link.
	rm -f "$pkgdir"/usr/lib/libz.a "$pkgdir"/usr/lib/libz.so
	rm -rf "$pkgdir"/usr/include "$pkgdir"/usr/share "$pkgdir"/usr/lib/pkgconfig
	test -L "$pkgdir"/usr/lib/libz.so.1
	test -e "$pkgdir"/usr/lib/libz.so.1
}

sha256sums="
02dd159783677a749c04adbdd02b55b8a2bcc7e054f51b76b549199a916ad584  zlib-$pkgver.tar.gz
"
