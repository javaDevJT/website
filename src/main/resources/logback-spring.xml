<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <springProperty name="openwoofEnabled" source="openwoof.telemetry.enabled" defaultValue="false"/>
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <filter class="com.jtdev.website.observability.TelemetryBridgeFilter">
            <enabled>${openwoofEnabled}</enabled>
        </filter>
        <numLogsCapturedBeforeOtelInstall>128</numLogsCapturedBeforeOtelInstall>
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
        <captureArguments>false</captureArguments>
        <captureCodeAttributes>false</captureCodeAttributes>
        <captureMdcAttributes></captureMdcAttributes>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
